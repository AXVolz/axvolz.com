---
import "../styles/global.css";
import { site } from "../data/site";

type Props = {
  title?: string;
  description?: string;
  bodyClass?: string;
  hideHeader?: boolean;
};

const { title, description = site.description, bodyClass, hideHeader } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isShare = path === "/";
const showQuietHeader = !isShare && !hideHeader;
---

<!doctype html>
<html lang="en" class:list={[bodyClass]}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Source+Sans+3:wght@400;600&family=Noto+Serif+SC:wght@400&family=Noto+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[bodyClass]}>
    {
      showQuietHeader && (
        <header class="site-header share-quiet">
          <div class="wrap header-inner">
            <a class="quiet-home" href={site.home}>
              Home
            </a>
          </div>
        </header>
      )
    }
    <main>
      <slot />
    </main>
  </body>
</html>
