---
import Base from "../layouts/Base.astro";
import { built } from "../data/built";
import { site } from "../data/site";

const current = built[0]!;
const previous = built.slice(1);
---

<Base
  title="Built"
  description="Things Austin X. Volz has built."
  bodyClass="share-built"
>
  <img
    class="built-photo"
    src="/built-pre-dawn.png"
    alt=""
    width="1920"
    height="1080"
    decoding="async"
  />

  <div class="built-frame">
    <header class="built-head">
      <p class="built-kicker">Things I’ve built</p>
    </header>

    <section class="works-group" aria-labelledby="built-now">
      <p class="when-kicker" id="built-now">Now</p>
      <ol class="works">
        <li class="work lead" id="p01">
          <h2>{current.title}</h2>
          <p class="role">{current.role}</p>
          <p class="pitch">
            {current.pitch}{" "}
            <a href={site.iguru}>I.GURU</a>
          </p>
          <details class="more">
            <summary>Read more</summary>
            <p>{current.summary}</p>
          </details>
        </li>
      </ol>
    </section>

    <section class="works-group previously" aria-labelledby="built-previously">
      <p class="when-kicker" id="built-previously">Previously</p>
      <ol class="works">
        {
          previous.map((item, i) => (
            <li class="work" id={`p${String(i + 2).padStart(2, "0")}`}>
              <h2>{item.title}</h2>
              <p class="role">{item.role}</p>
              <p class="pitch">{item.pitch}</p>
              <details class="more">
                <summary>Read more</summary>
                <p>{item.summary}</p>
              </details>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>

<style is:global>
  body.share-built {
    --gilt: #c59d5f;
    --gilt-bright: #f0d78a;
    background: #070b18;
    color: #f7f4ee;
  }

  body.share-built .site-header,
  body.share-built .site-footer {
    position: relative;
    z-index: 3;
    background: transparent;
  }

  body.share-built .site-footer {
    border-top-color: rgba(197, 157, 95, 0.18);
  }
</style>

<style>
  .built-photo {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 70% 40%;
    pointer-events: none;
  }

  .built-frame {
    position: relative;
    z-index: 2;
    width: min(62rem, calc(100% - 4rem));
    margin: 0 auto;
    padding: 3.2rem 0 6rem;
  }

  .built-kicker {
    font-family: var(--ui);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(247, 244, 238, 0.88);
    margin: 0 0 1.15rem;
  }

  .built-kicker::after {
    content: "";
    display: block;
    width: 2.35rem;
    height: 1px;
    background: #c59d5f;
    margin-top: 0.85rem;
  }

  .when-kicker {
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c59d5f;
    margin: 0 0 1.15rem;
  }

  .previously {
    margin-top: 4.2rem;
  }

  .previously .when-kicker {
    margin-bottom: 0.7rem;
  }

  .works {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3.4rem;
  }

  .work {
    scroll-margin-top: 4.5rem;
    max-width: 38rem;
  }

  .work h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.7rem);
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.03em;
    line-height: 1.16;
    color: #c59d5f;
    text-shadow: 0 8px 28px rgba(7, 11, 24, 0.55);
  }

  .lead h2 {
    font-size: clamp(2.05rem, 3.8vw, 3.05rem);
    max-width: 18ch;
  }

  .work h2 a {
    color: inherit;
    text-decoration: none;
  }

  .work h2 a:hover,
  .work h2 a:focus-visible {
    color: #f0d78a;
  }

  .role {
    margin: 0.55rem 0 0;
    font-family: var(--ui);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.58);
  }

  .pitch {
    font-family: var(--ui);
    font-size: 0.98rem;
    font-weight: 400;
    line-height: 1.45;
    max-width: 36ch;
    margin: 0.85rem 0 0;
    color: rgba(247, 244, 238, 0.78);
  }

  .lead .pitch {
    max-width: 38ch;
    margin-top: 1.15rem;
  }

  .lead .pitch a {
    color: var(--gilt);
    text-decoration-color: color-mix(in srgb, var(--gilt) 45%, transparent);
  }

  .lead .pitch a:hover,
  .lead .pitch a:focus-visible {
    color: var(--gilt-bright);
  }

  .more {
    margin-top: 0.7rem;
    max-width: 42ch;
  }

  .more summary {
    font-family: var(--ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c59d5f;
    cursor: pointer;
    width: fit-content;
    list-style: none;
  }

  .more summary::-webkit-details-marker,
  .more summary::marker {
    display: none;
    content: "";
  }

  .more summary::after {
    content: "";
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    margin-left: 0.45rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-0.12rem) rotate(45deg);
    transition: transform 0.2s ease;
  }

  .more[open] summary::after {
    transform: translateY(0.08rem) rotate(-135deg);
  }

  .more summary:hover {
    color: #f0d78a;
  }

  .more p {
    font-family: var(--ui);
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(247, 244, 238, 0.7);
    margin: 0.7rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(197, 160, 89, 0.28);
  }

  @media (max-width: 840px) {
    .built-frame {
      width: calc(100% - 2.8rem);
      padding: 2.2rem 0 4.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .more summary::after {
      transition: none;
    }
  }
</style>
