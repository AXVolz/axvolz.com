---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { built } from "../data/built";
import { places, localityLine, ridgePts } from "../data/places";

const teaser = built.slice(0, 5);
const iguru = teaser[0]!;
const otherBuilt = teaser.slice(1);

const languages = [
  { name: "Spanish", native: "Español", script: "es" },
  { name: "Ancient Greek", native: "Ἀρχαία Ἑλληνική", script: "el" },
  { name: "Modern Greek", native: "Ελληνικά", script: "el" },
  { name: "Literary French", native: "français littéraire", script: "fr" },
  { name: "German", native: "Deutsch", script: "de" },
  { name: "Classical Chinese", native: "文言文", script: "zh" },
  { name: "Mandarin Chinese", native: "普通话", script: "zh" },
] as const;

const hereIndex = places.length - 1;
const cityCount = new Set(places.map((place) => place.city)).size;

const placeStars = places.map((place, i) => ({
  ...place,
  locality: localityLine(place),
  x: ridgePts[i]![0],
  y: ridgePts[i]![1],
  i,
}));

const placePath = placeStars
  .map((p, i) => {
    const x = (p.x / 100) * 1440;
    const y = (p.y / 100) * 720;
    return i === 0 ? `M ${x} ${y}` : `L ${x} ${y}`;
  })
  .join(" ");
---

<Base bodyClass="share-home">
  <div class="home-stage">
    <header class="cg-masthead">
      <a class="cg-btn cg-btn-ghost" href="/contact">Get in touch</a>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <h1 class="display-name">Austin X. Volz</h1>
        <p class="lede">
          Growing up, I loved learning but hated school. Now I’m building a way
          for serious learners to directly prove their expertise. No schools
          required.
        </p>
      </div>
      <div class="hero-art" data-summit-egg>
        <img
          class="hero-mountain"
          src="/mountain.png?v=3"
          alt=""
          width="1024"
          height="1024"
          decoding="async"
        />
        <canvas class="summit-fall" aria-hidden="true"></canvas>
        <button type="button" class="summit-hit" aria-label="Summit"></button>
      </div>
    </section>
  </div>

  <section class="cg-built" id="built">
    <img
      class="cg-built-photo"
      src="/built-pre-dawn.png"
      alt=""
      width="1920"
      height="1080"
      decoding="async"
    />

    <div class="cg-built-frame">
      <header class="cg-built-head">
        <p class="cg-banner-kicker">Things I’ve built</p>
        <p class="cg-when">Now</p>
        <h2>{iguru.title}</h2>
        <p class="cg-lead-role">{iguru.role}</p>
        <p class="cg-index-summary cg-lead-summary">
          {iguru.pitch}{" "}
          <a href={site.iguru}>I.GURU</a>
        </p>
        <details class="cg-more">
          <summary>Read more</summary>
          <p>{iguru.summary}</p>
        </details>
      </header>
      <div class="cg-built-foot">
        <div class="cg-previous">
          <p class="cg-when">Previously</p>
          <ul class="cg-index">
            {
              otherBuilt.map((item) => (
                <li>
                  <div class="cg-index-title">
                    <strong>{item.title}</strong>
                    <span class="cg-index-role">{item.role}</span>
                  </div>
                  <p class="cg-index-summary">{item.pitch}</p>
                  <details class="cg-more">
                    <summary>Read more</summary>
                    <p>{item.summary}</p>
                  </details>
                </li>
              ))
            }
          </ul>
        </div>
        <p class="cg-built-all">
          <a href="/built">All built →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="cg-lived" id="lived">
    <img
      class="cg-lived-photo"
      src="/lived-golden-hour.png"
      alt=""
      width="1920"
      height="1080"
      decoding="async"
    />
    <svg
      class="cg-day-sky"
      viewBox="0 0 1440 720"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d={placePath}
        fill="none"
        stroke="#d4af5a"
        stroke-width="1.05"
        opacity="0.7"></path>
    </svg>

    <div class="cg-lived-copy" data-panel="lived">
      <h2>
        How I got here.
        <em>An early love of languages propelled me around the world.</em>
      </h2>
      <p class="cg-lived-count">
        {cityCount} cities · Greece, Germany, China, USA
      </p>
      <details class="cg-langs">
        <summary>Seven languages</summary>
        <ul>
          {
            languages.map((lang) => (
              <li>
                <span>{lang.name}</span>
                <span class="cg-lang-dash" aria-hidden="true">
                  —
                </span>
                <span class:list={["cg-lang-native", `is-${lang.script}`]} lang={lang.script}>
                  {lang.native}
                </span>
              </li>
            ))
          }
        </ul>
      </details>
      <p class="cg-summary cg-summary-day" data-summary>
        {placeStars[hereIndex]!.short}
      </p>
      <p class="cg-place-kicker" data-locality>
        {placeStars[hereIndex]!.locality}
      </p>
      <h3 data-title>{placeStars[hereIndex]!.city}</h3>
      <a
        class="cg-btn cg-btn-ember"
        href="/lived#durango"
        data-journey
      >
        The whole journey →
      </a>
    </div>

    <div class="cg-stars cg-stars-day" data-stars="lived">
      {
        placeStars.map((star, i) => (
          <a
            class:list={[
              "cg-star",
              "cg-star-place",
              { "is-on": i === hereIndex },
            ]}
            style={`left:${star.x}%; top:${star.y}%`}
            href={`/lived#${star.slug}`}
            data-star={star.slug}
            data-title={star.city}
            data-role={star.locality}
            data-summary={star.short}
            aria-current={i === hereIndex ? "true" : undefined}
          >
            <span class="cg-star-core"></span>
            <span class="cg-star-name">{star.city}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="cg-bookish" id="bookish">
    <h2><a href="/bookish">Bookish Pursuits</a></h2>
  </section>

  <p class="cg-linkedin">
    See the <a href={site.linkedin} rel="me">LinkedIn version</a>.
  </p>
</Base>

<script>
  function bindPanel(group: string) {
    const root = document.querySelector(`[data-stars="${group}"]`);
    const panel = document.querySelector(`[data-panel="${group}"]`);
    if (!(root instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;

    const stars = [...root.querySelectorAll<HTMLAnchorElement>("[data-star]")];
    const title = panel.querySelector("[data-title]");
    const role = panel.querySelector("[data-role], [data-locality]");
    const summary = panel.querySelector("[data-summary]");

    const select = (btn: HTMLAnchorElement) => {
      stars.forEach((star) => {
        const on = star === btn;
        star.classList.toggle("is-on", on);
        if (on) star.setAttribute("aria-current", "true");
        else star.removeAttribute("aria-current");
      });
      if (title) title.textContent = btn.dataset.title ?? "";
      if (role) role.textContent = btn.dataset.role ?? "";
      if (summary) summary.textContent = btn.dataset.summary ?? "";
    };

    stars.forEach((star) => {
      star.addEventListener("mouseenter", () => select(star));
      star.addEventListener("focus", () => select(star));
    });
  }

  bindPanel("lived");
</script>

<script>
  const SUMMIT = { x: 0.5, y: 0.137 };
  const RIDGES = [
    { cx: 0.36, cy: 0.36, ex: 0.14, ey: 0.9, delay: 0.03, width: 0.24 },
    { cx: 0.4, cy: 0.42, ex: 0.26, ey: 0.97, delay: 0, width: 0.3 },
    { cx: 0.44, cy: 0.48, ex: 0.38, ey: 0.99, delay: 0.04, width: 0.34 },
    { cx: 0.5, cy: 0.5, ex: 0.51, ey: 1.02, delay: 0.01, width: 0.4 },
    { cx: 0.56, cy: 0.48, ex: 0.64, ey: 0.99, delay: 0.05, width: 0.34 },
    { cx: 0.6, cy: 0.42, ex: 0.76, ey: 0.94, delay: 0.07, width: 0.28 },
    { cx: 0.66, cy: 0.36, ex: 0.88, ey: 0.86, delay: 0.09, width: 0.22 },
  ] as const;
  const DURATION = 4400;

  const egg = document.querySelector<HTMLElement>("[data-summit-egg]");
  const img = egg?.querySelector<HTMLImageElement>(".hero-mountain");
  const canvas = egg?.querySelector<HTMLCanvasElement>(".summit-fall");
  const hit = egg?.querySelector<HTMLButtonElement>(".summit-hit");
  const lived = document.querySelector<HTMLElement>(".cg-lived");
  const nodes = [
    ...document.querySelectorAll<HTMLElement>('[data-stars="lived"] [data-star]'),
  ];
  if (egg && img && canvas && hit) {
    const ctx = canvas.getContext("2d");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let running = false;
    let raf = 0;
    let box = { x: 0, y: 0, w: 0, h: 0 };

    function parsePos(value: string, fallback: number) {
      if (value.endsWith("%")) return Number.parseFloat(value) / 100;
      return fallback;
    }

    function imageBox() {
      const r = img!.getBoundingClientRect();
      const art = egg!.getBoundingClientRect();
      const nw = img!.naturalWidth || 1024;
      const nh = img!.naturalHeight || 1024;
      const ir = nw / nh;
      const cr = r.width / r.height;
      let w: number;
      let h: number;
      if (ir > cr) {
        w = r.width;
        h = r.width / ir;
      } else {
        h = r.height;
        w = r.height * ir;
      }
      const parts = getComputedStyle(img!).objectPosition.split(" ");
      const ox = parsePos(parts[0] ?? "50%", 0.5);
      const oy = parsePos(parts[1] ?? "50%", 0.5);
      return {
        x: r.left - art.left + (r.width - w) * ox,
        y: r.top - art.top + (r.height - h) * oy,
        w,
        h,
      };
    }

    function toXY(nx: number, ny: number) {
      return { x: box.x + nx * box.w, y: box.y + ny * box.h };
    }

    function sizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const { width, height } = egg!.getBoundingClientRect();
      canvas!.width = Math.max(1, Math.round(width * dpr));
      canvas!.height = Math.max(1, Math.round(height * dpr));
      canvas!.style.width = `${width}px`;
      canvas!.style.height = `${height}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      box = imageBox();
      const peak = toXY(SUMMIT.x, SUMMIT.y);
      hit!.style.left = `${peak.x}px`;
      hit!.style.top = `${peak.y}px`;
    }

    function ease(t: number) {
      return 1 - (1 - Math.min(1, Math.max(0, t))) ** 2.15;
    }

    function qPoint(
      ax: number,
      ay: number,
      cx: number,
      cy: number,
      bx: number,
      by: number,
      t: number,
    ) {
      const u = 1 - t;
      return {
        x: u * u * ax + 2 * u * t * cx + t * t * bx,
        y: u * u * ay + 2 * u * t * cy + t * t * by,
      };
    }

    function qTan(
      ax: number,
      ay: number,
      cx: number,
      cy: number,
      bx: number,
      by: number,
      t: number,
    ) {
      const dx = 2 * (1 - t) * (cx - ax) + 2 * t * (bx - cx);
      const dy = 2 * (1 - t) * (cy - ay) + 2 * t * (by - cy);
      const len = Math.hypot(dx, dy) || 1;
      return { x: dx / len, y: dy / len };
    }

    function fillRibbon(
      left: { x: number; y: number }[],
      right: { x: number; y: number }[],
    ) {
      if (!ctx || !left[0] || !right[0]) return;
      ctx.beginPath();
      ctx.moveTo(left[0].x, left[0].y);
      for (const p of left) ctx.lineTo(p.x, p.y);
      for (let i = right.length - 1; i >= 0; i--) {
        ctx.lineTo(right[i]!.x, right[i]!.y);
      }
      ctx.closePath();
      ctx.fill();
    }

    function ribbon(
      ridge: (typeof RIDGES)[number],
      back: number,
      front: number,
      scale: number,
    ) {
      const peak = toXY(SUMMIT.x, SUMMIT.y);
      const ctrl = toXY(ridge.cx, ridge.cy);
      const end = toXY(ridge.ex, ridge.ey);
      const steps = 28;
      const left: { x: number; y: number }[] = [];
      const right: { x: number; y: number }[] = [];
      for (let i = 0; i <= steps; i++) {
        const t = back + ((front - back) * i) / steps;
        const p = qPoint(peak.x, peak.y, ctrl.x, ctrl.y, end.x, end.y, t);
        const tan = qTan(peak.x, peak.y, ctrl.x, ctrl.y, end.x, end.y, t);
        const along = i / steps;
        const envelope = Math.sin(along * Math.PI) ** 0.42;
        const w =
          box.w *
          ridge.width *
          scale *
          (0.38 + 1.05 * t) *
          (0.58 + 0.42 * envelope);
        left.push({ x: p.x - tan.y * w, y: p.y + tan.x * w });
        right.push({ x: p.x + tan.y * w, y: p.y - tan.x * w });
      }
      const lead = qPoint(peak.x, peak.y, ctrl.x, ctrl.y, end.x, end.y, front);
      return { left, right, peak, lead };
    }

    function ridgeFront(ridge: (typeof RIDGES)[number], progress: number) {
      const local = (progress - ridge.delay) / 0.82;
      if (local <= 0) return 0;
      return ease(Math.min(1, local));
    }

    function drawDarkSheet(
      ridge: (typeof RIDGES)[number],
      progress: number,
      fade: number,
    ) {
      if (!ctx) return;
      const front = ridgeFront(ridge, progress);
      if (front < 0.02) return;
      const { left, right } = ribbon(ridge, 0, front, 1.55);
      ctx.fillStyle = `rgba(0, 0, 0, ${0.9 * fade})`;
      fillRibbon(left, right);
    }

    function drawSnowSheet(
      ridge: (typeof RIDGES)[number],
      progress: number,
      fade: number,
      scale: number,
      alpha: number,
      span: number,
    ) {
      if (!ctx) return;
      const front = ridgeFront(ridge, progress);
      const back = Math.max(progress > 0.12 ? 0.06 : 0, front - span);
      if (front - back < 0.03) return;
      const { left, right, peak, lead } = ribbon(ridge, back, front, scale);
      const wash = ctx.createLinearGradient(peak.x, peak.y, lead.x, lead.y);
      wash.addColorStop(0, `rgba(255, 232, 176, ${0.12 * fade * alpha})`);
      wash.addColorStop(0.16, `rgba(255, 226, 158, ${0.72 * fade * alpha})`);
      wash.addColorStop(0.48, `rgba(255, 246, 218, ${0.98 * fade * alpha})`);
      wash.addColorStop(0.82, `rgba(255, 252, 236, ${0.88 * fade * alpha})`);
      wash.addColorStop(1, `rgba(255, 240, 200, ${0.18 * fade * alpha})`);
      ctx.fillStyle = wash;
      fillRibbon(left, right);
    }

    function burySummit(progress: number, fade: number) {
      if (!ctx) return;
      const peak = toXY(SUMMIT.x, SUMMIT.y);
      const cover = Math.min(1, progress / 0.06) * fade;
      const r = box.w * 0.2;
      ctx.save();
      ctx.filter = "blur(6px)";
      const kill = ctx.createRadialGradient(
        peak.x,
        peak.y,
        r * 0.04,
        peak.x,
        peak.y,
        r,
      );
      kill.addColorStop(0, `rgba(0, 0, 0, ${1 * cover})`);
      kill.addColorStop(0.38, `rgba(0, 0, 0, ${0.92 * cover})`);
      kill.addColorStop(0.7, `rgba(0, 0, 0, ${0.45 * cover})`);
      kill.addColorStop(1, "rgba(0, 0, 0, 0)");
      ctx.fillStyle = kill;
      ctx.beginPath();
      ctx.arc(peak.x, peak.y, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function snuffNodes(progress: number, active: boolean) {
      const n = nodes.length;
      nodes.forEach((node, i) => {
        const at = n < 2 ? 0.18 : 0.1 + (i / (n - 1)) * 0.7;
        node.classList.toggle("is-snuffed", active && progress >= at);
      });
    }

    function restore() {
      const { width, height } = egg!.getBoundingClientRect();
      ctx?.clearRect(0, 0, width, height);
      egg!.classList.remove("is-falling");
      lived?.classList.remove("is-snuffing");
      snuffNodes(0, false);
      running = false;
    }

    function draw(progress: number) {
      if (!ctx) return;
      const { width, height } = egg!.getBoundingClientRect();
      ctx.clearRect(0, 0, width, height);
      const peak = toXY(SUMMIT.x, SUMMIT.y);
      const fade = progress > 0.82 ? 1 - (progress - 0.82) / 0.18 : 1;
      const front = ease(Math.min(1, progress / 0.88));
      snuffNodes(progress, true);

      burySummit(progress, fade);

      ctx.save();
      ctx.filter = "blur(6px)";
      for (const ridge of RIDGES) drawDarkSheet(ridge, progress, fade * 0.55);
      for (const ridge of RIDGES) {
        drawSnowSheet(ridge, progress, fade, 1.32, 1, 0.84);
      }
      ctx.filter = "blur(3.5px)";
      for (const ridge of RIDGES) {
        drawSnowSheet(ridge, progress, fade, 0.78, 0.9, 0.58);
      }

      const gleamY = peak.y + box.h * (0.16 + 0.68 * front);
      const gleam = ctx.createRadialGradient(
        peak.x + box.w * 0.02,
        gleamY,
        box.h * 0.005,
        peak.x + box.w * 0.02,
        gleamY,
        box.w * (0.08 + 0.12 * front),
      );
      gleam.addColorStop(0, `rgba(255, 252, 240, ${0.4 * fade})`);
      gleam.addColorStop(0.55, `rgba(255, 236, 186, ${0.14 * fade})`);
      gleam.addColorStop(1, "rgba(255, 248, 220, 0)");
      ctx.fillStyle = gleam;
      ctx.beginPath();
      ctx.ellipse(
        peak.x + box.w * 0.02,
        gleamY,
        box.w * (0.11 + 0.14 * front),
        box.h * 0.024,
        0.08,
        0,
        Math.PI * 2,
      );
      ctx.fill();
      ctx.restore();
    }

    function flash() {
      if (!ctx) return;
      sizeCanvas();
      lived?.classList.add("is-snuffing");
      snuffNodes(1, true);
      draw(0.5);
      window.setTimeout(restore, 420);
    }

    function play() {
      if (running) return;
      running = true;
      egg!.classList.add("is-falling");
      lived?.classList.add("is-snuffing");
      sizeCanvas();
      if (reduce) {
        flash();
        return;
      }
      const start = performance.now();
      const tick = (now: number) => {
        const t = (now - start) / DURATION;
        if (t >= 1) {
          restore();
          return;
        }
        draw(t);
        raf = requestAnimationFrame(tick);
      };
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(tick);
    }

    hit.addEventListener("click", play);
    img.addEventListener("load", sizeCanvas);
    window.addEventListener("resize", sizeCanvas);
    sizeCanvas();
  }
</script>

<style is:global>
  body.share-home {
    --gilt: #c59d5f;
    --gilt-bright: #f0d78a;
    background: #000;
    color: #f7f4ee;
  }

  body.share-home .home-stage {
    background: #000;
  }

  .hero-art[data-summit-egg] {
    isolation: isolate;
  }

  .hero-art .hero-mountain {
    pointer-events: none;
  }

  .summit-fall {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: blur(0.45px);
  }

  .summit-hit {
    position: absolute;
    z-index: 4;
    width: 8.2rem;
    height: 8.2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    left: 46%;
    top: 20%;
    background: radial-gradient(
      circle,
      rgba(255, 246, 210, 0.14) 0%,
      rgba(212, 175, 90, 0.06) 38%,
      transparent 70%
    );
    box-shadow: 0 0 16px 5px rgba(212, 175, 90, 0.07);
    animation: summit-shimmer 4.2s ease-in-out infinite;
  }

  .summit-hit:hover,
  .summit-hit:focus-visible {
    background: radial-gradient(
      circle,
      rgba(255, 246, 210, 0.58) 0%,
      rgba(212, 175, 90, 0.22) 40%,
      transparent 72%
    );
    box-shadow: 0 0 42px 14px rgba(240, 215, 138, 0.28);
    outline: none;
  }

  .hero-art.is-falling .summit-hit,
  .hero-art.is-falling .summit-hit:hover,
  .hero-art.is-falling .summit-hit:focus-visible {
    animation: none;
    opacity: 0;
    background: transparent;
    box-shadow: none;
  }

  @keyframes summit-shimmer {
    0%,
    100% {
      opacity: 0.32;
      filter: brightness(1);
    }
    50% {
      opacity: 0.52;
      filter: brightness(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .summit-hit {
      animation: none;
    }
  }

  .cg-masthead {
    flex-shrink: 0;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem max(2rem, calc((100vw - 78rem) / 2));
    position: relative;
    z-index: 3;
  }

  .cg-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.92rem 1.4rem;
    border-radius: 0;
  }

  .cg-btn-ghost {
    border: 1px solid #c59d5f;
    color: #c59d5f;
    background: transparent;
  }

  .cg-btn-ember {
    background: #b33c1c;
    color: #fff;
    margin-top: 1.7rem;
  }

  .cg-btn-ember:hover {
    color: #fff;
    background: #c44924;
  }

  .cg-built,
  .cg-lived {
    position: relative;
    overflow: hidden;
    min-height: 92vh;
  }

  .cg-built {
    background: #070b18;
  }

  .cg-built-photo,
  .cg-lived-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 72% 48%;
    pointer-events: none;
  }

