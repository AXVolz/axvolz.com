---
import Base from "../layouts/Base.astro";
import LivedCave from "../components/LivedCave.astro";
import { site } from "../data/site";
import { built } from "../data/built";
import { places, localityLine, ridgePts } from "../data/places";

const teaser = built.slice(0, 5);
const iguru = teaser[0]!;
const otherBuilt = teaser.slice(1);

const languages = [
  { name: "Spanish", native: "Español", script: "es" },
  { name: "Ancient Greek", native: "Ἀρχαία Ἑλληνική", script: "el" },
  { name: "Modern Greek", native: "Ελληνικά", script: "el" },
  { name: "Literary French", native: "français littéraire", script: "fr" },
  { name: "German", native: "Deutsch", script: "de" },
  { name: "Classical Chinese", native: "文言文", script: "zh" },
  { name: "Mandarin Chinese", native: "普通话", script: "zh" },
] as const;

const hereIndex = places.length - 1;
const cityCount = new Set(places.map((place) => place.city)).size;

const placeStars = places.map((place, i) => ({
  ...place,
  locality: localityLine(place),
  x: ridgePts[i]![0],
  y: ridgePts[i]![1],
  i,
}));

const placePath = placeStars
  .map((p, i) => `${i === 0 ? "M" : "L"} ${p.x} ${p.y}`)
  .join(" ");
---

<Base bodyClass="share-home">
  <div class="home-stage">
    <section class="hero">
      <div class="hero-copy">
        <h1 class="display-name">Austin X. Volz</h1>
        <p class="lede">
          Growing up, I loved learning but hated school. Now I’m building a way
          for serious learners to directly prove their expertise. No schools
          required.
        </p>
      </div>
      <div class="hero-art" data-summit-egg>
        <img
          class="hero-mountain"
          src="/mountain.png?v=3"
          alt=""
          width="1024"
          height="1024"
          decoding="async"
        />
        <canvas class="summit-fall" aria-hidden="true"></canvas>
        <button type="button" class="summit-hit" aria-label="Summit"></button>
        <p class="hero-eggs">You can find two surprises on this site if you click around. Both of them on mountains.</p>
      </div>
    </section>
  </div>

  <section class="cg-built" id="built">
    <img
      class="cg-built-photo"
      src="/built-pre-dawn.png"
      alt=""
      width="1920"
      height="1080"
      decoding="async"
    />

    <div class="cg-built-frame">
      <header class="cg-built-head">
        <p class="cg-banner-kicker">Things I built or led</p>
        <p class="cg-when">Now</p>
        <h2>{iguru.title}</h2>
        <p class="cg-lead-role">{iguru.role}</p>
        <p class="cg-index-summary cg-lead-summary">
          {iguru.pitch}{" "}
          <a href={site.iguru}>I.GURU</a>
        </p>
        <details class="cg-more">
          <summary>Read more</summary>
          <p>{iguru.summary}</p>
        </details>
      </header>
      <div class="cg-built-foot">
        <div class="cg-previous">
          <p class="cg-when">Previously</p>
          <ul class="cg-index">
            {
              otherBuilt.map((item) => (
                <li>
                  <div class="cg-index-title">
                    <strong>{item.title}</strong>
                    <span class="cg-index-role">{item.role}</span>
                  </div>
                  <p class="cg-index-summary">{item.pitch}</p>
                  <details class="cg-more">
                    <summary>Read more</summary>
                    <p>{item.summary}</p>
                  </details>
                </li>
              ))
            }
          </ul>
        </div>
        <p class="cg-built-all">
          <a href="/built">All built →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="cg-lived" id="lived">
    <div class="cg-lived-stage">
      <img
        class="cg-lived-photo"
        src="/lived-golden-hour.png"
        alt=""
        width="1536"
        height="1024"
        decoding="async"
      />
      <div class="cg-lived-plot">
        <svg
          class="cg-day-sky"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d={placePath}
            fill="none"
            stroke="#d4af5a"
            stroke-width="1.05"
            opacity="0.7"></path>
        </svg>

        <div class="cg-stars cg-stars-day" data-stars="lived">
          {
            placeStars.map((star, i) => (
              <div
                class:list={[
                  "cg-star",
                  "cg-star-place",
                  { "is-on": i === hereIndex },
                ]}
                style={`left:${star.x}%; top:${star.y}%`}
                data-star={star.slug}
                data-title={star.city}
                data-role={star.locality}
                data-summary={star.short}
              >
                <span class="cg-star-core" aria-hidden="true"></span>
                <a
                  class="cg-star-name"
                  href={`/lived#${star.slug}`}
                  aria-current={i === hereIndex ? "true" : undefined}
                >
                  {star.city}
                </a>
              </div>
            ))
          }
        </div>
        <LivedCave />
      </div>
    </div>

    <div class="cg-lived-copy" data-panel="lived">
      <h2>
        How I got here.
        <em>An early love of languages propelled me around the world.</em>
      </h2>
      <p class="cg-lived-count">
        {cityCount} cities · Greece, Germany, China, USA
      </p>
      <details class="cg-langs">
        <summary>Seven languages</summary>
        <ul>
          {
            languages.map((lang) => (
              <li>
                <span>{lang.name}</span>
                <span class="cg-lang-dash" aria-hidden="true">
                  —
                </span>
                <span class:list={["cg-lang-native", `is-${lang.script}`]} lang={lang.script}>
                  {lang.native}
                </span>
              </li>
            ))
          }
        </ul>
      </details>
      <p class="cg-summary cg-summary-day" data-summary>
        {placeStars[hereIndex]!.short}
      </p>
      <p class="cg-place-kicker" data-locality>
        {placeStars[hereIndex]!.locality}
      </p>
      <h3 data-title>{placeStars[hereIndex]!.city}</h3>
      <a
        class="cg-btn cg-btn-ember"
        href="/lived#durango"
        data-journey
      >
        The whole journey →
      </a>
    </div>
  </section>

  <section class="cg-bookish" id="bookish">
    <h2><a href="/bookish">Bookish Pursuits</a></h2>
  </section>

  <footer class="cg-foot">
    <p class="cg-linkedin">
      See the <a href={site.linkedin} rel="me">LinkedIn version</a>.
    </p>
    <a class="cg-btn cg-btn-ghost" href="/contact">Get in touch</a>
  </footer>
</Base>

<script>
  function bindPanel(group: string) {
    const root = document.querySelector(`[data-stars="${group}"]`);
    const panel = document.querySelector(`[data-panel="${group}"]`);
    if (!(root instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;

    const stars = [...root.querySelectorAll<HTMLElement>("[data-star]")];
    const title = panel.querySelector("[data-title]");
    const role = panel.querySelector("[data-role], [data-locality]");
    const summary = panel.querySelector("[data-summary]");

    const select = (btn: HTMLElement) => {
      stars.forEach((star) => {
        const on = star === btn;
        star.classList.toggle("is-on", on);
        const name = star.querySelector(".cg-star-name");
        if (name instanceof HTMLElement) {
          if (on) name.setAttribute("aria-current", "true");
          else name.removeAttribute("aria-current");
        }
      });
      if (title) title.textContent = btn.dataset.title ?? "";
      if (role) role.textContent = btn.dataset.role ?? "";
      if (summary) summary.textContent = btn.dataset.summary ?? "";
    };

    stars.forEach((star) => {
      const name = star.querySelector(".cg-star-name");
      name?.addEventListener("mouseenter", () => select(star));
      name?.addEventListener("focus", () => select(star));
    });
  }

  bindPanel("lived");
</script>

<script>
  function parsePos(value: string, fallback: number) {
    if (value.endsWith("%")) return Number.parseFloat(value) / 100;
    return fallback;
  }

  function fitLivedPlot() {
    const section = document.querySelector<HTMLElement>(".cg-lived");
    const img = section?.querySelector<HTMLImageElement>(".cg-lived-photo");
    const plot = section?.querySelector<HTMLElement>(".cg-lived-plot");
    if (!section || !img || !plot) return;

    const r = img.getBoundingClientRect();
    const host = section.getBoundingClientRect();
    const nw = img.naturalWidth || 1536;
    const nh = img.naturalHeight || 1024;
    if (!r.width || !r.height) return;

    const ir = nw / nh;
    const cr = r.width / r.height;
    const fit = getComputedStyle(img).objectFit;
    const parts = getComputedStyle(img).objectPosition.split(" ");
    const ox = parsePos(parts[0] ?? "50%", 0.5);
    const oy = parsePos(parts[1] ?? "50%", 0.5);

    let w: number;
    let h: number;
    if (fit === "contain") {
      if (ir > cr) {
        w = r.width;
        h = r.width / ir;
      } else {
        h = r.height;
        w = r.height * ir;
      }
    } else if (cr > ir) {
      w = r.width;
      h = r.width / ir;
    } else {
      h = r.height;
      w = r.height * ir;
    }

    plot.style.left = `${r.left - host.left + (r.width - w) * ox}px`;
    plot.style.top = `${r.top - host.top + (r.height - h) * oy}px`;
    plot.style.width = `${w}px`;
    plot.style.height = `${h}px`;
  }

  fitLivedPlot();
  window.addEventListener("resize", fitLivedPlot);
  document.querySelector(".cg-lived-photo")?.addEventListener("load", fitLivedPlot);
</script>

<script>
  const SUMMIT = { x: 0.5, y: 0.137 };
  const DURATION = 3600;

  const egg = document.querySelector<HTMLElement>("[data-summit-egg]");
  const img = egg?.querySelector<HTMLImageElement>(".hero-mountain");
  const canvas = egg?.querySelector<HTMLCanvasElement>(".summit-fall");
  const hit = egg?.querySelector<HTMLButtonElement>(".summit-hit");
  if (egg && img && canvas && hit) {
    const ctx = canvas.getContext("2d");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let running = false;
    let raf = 0;
    let box = { x: 0, y: 0, w: 0, h: 0 };
    let mesh = {
      nodes: [] as { x: number; y: number; at: number }[],
      edges: [] as { a: number; b: number }[],
    };

    function parsePos(value: string, fallback: number) {
      if (value.endsWith("%")) return Number.parseFloat(value) / 100;
      return fallback;
    }

    function imageBox() {
      const r = img!.getBoundingClientRect();
      const art = egg!.getBoundingClientRect();
      const nw = img!.naturalWidth || 1024;
      const nh = img!.naturalHeight || 1024;
      const ir = nw / nh;
      const cr = r.width / r.height;
      let w: number;
      let h: number;
      if (ir > cr) {
        w = r.width;
        h = r.width / ir;
      } else {
        h = r.height;
        w = r.height * ir;
      }
      const parts = getComputedStyle(img!).objectPosition.split(" ");
      const ox = parsePos(parts[0] ?? "50%", 0.5);
      const oy = parsePos(parts[1] ?? "50%", 0.5);
      return {
        x: r.left - art.left + (r.width - w) * ox,
        y: r.top - art.top + (r.height - h) * oy,
        w,
        h,
      };
    }

    function toXY(nx: number, ny: number) {
      return { x: box.x + nx * box.w, y: box.y + ny * box.h };
    }

    function sizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const { width, height } = egg!.getBoundingClientRect();
      canvas!.width = Math.max(1, Math.round(width * dpr));
      canvas!.height = Math.max(1, Math.round(height * dpr));
      canvas!.style.width = `${width}px`;
      canvas!.style.height = `${height}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      box = imageBox();
      const peak = toXY(SUMMIT.x, SUMMIT.y);
      hit!.style.left = `${peak.x}px`;
      hit!.style.top = `${peak.y}px`;
    }

    function ease(t: number) {
      return 1 - (1 - Math.min(1, Math.max(0, t))) ** 2.15;
    }

    function sampleMesh() {
      if (!img!.naturalWidth) return;
      const nw = img!.naturalWidth;
      const nh = img!.naturalHeight;
      const probe = document.createElement("canvas");
      probe.width = nw;
      probe.height = nh;
      const pctx = probe.getContext("2d", { willReadFrequently: true });
      if (!pctx) return;
      pctx.drawImage(img!, 0, 0);
      const { data } = pctx.getImageData(0, 0, nw, nh);
      const gold: { x: number; y: number; v: number }[] = [];
      for (let y = 2; y < nh - 2; y += 2) {
        for (let x = 2; x < nw - 2; x += 2) {
          const i = (y * nw + x) * 4;
          const r = data[i] ?? 0;
          const g = data[i + 1] ?? 0;
          const b = data[i + 2] ?? 0;
          const v = (r + g) / 2 - b;
          if (r > 150 && g > 110 && b < 160 && r > b + 36 && v > 58) {
            gold.push({ x, y, v });
          }
        }
      }
      gold.sort((a, b) => b.v - a.v);
      const found: { x: number; y: number; v: number }[] = [];
      const minDist = Math.max(8, nw * 0.009);
      for (const c of gold) {
        if (found.some((n) => Math.hypot(n.x - c.x, n.y - c.y) < minDist)) continue;
        found.push(c);
      }
      if (!found.length) return;

      let peak = 0;
      let peakScore = Infinity;
      found.forEach((n, i) => {
        const score = Math.hypot(n.x / nw - SUMMIT.x, n.y / nh - SUMMIT.y) - n.v / 8000;
        if (score < peakScore) {
          peakScore = score;
          peak = i;
        }
      });

      const maxEdge = nw * 0.058;
      const links: number[][] = found.map(() => []);
      found.forEach((a, i) => {
        const near = found
          .map((b, j) => ({ j, d: Math.hypot(a.x - b.x, a.y - b.y) }))
          .filter((n) => n.j !== i && n.d < maxEdge)
          .sort((n, m) => n.d - m.d)
          .slice(0, 5);
        for (const n of near) links[i]!.push(n.j);
      });

      const dist = found.map(() => Infinity);
      dist[peak] = 0;
      const walk = [peak];
      const seenHop = new Set([peak]);
      while (walk.length) {
        const i = walk.shift()!;
        for (const j of links[i] ?? []) {
          if (seenHop.has(j)) continue;
          seenHop.add(j);
          dist[j] = (dist[i] ?? 0) + 1;
          walk.push(j);
        }
      }

      const reachable = dist.filter((d) => d < Infinity);
      const maxD = Math.max(...reachable, 1);
      const nodes = found.map((n, i) => ({
        x: n.x / nw,
        y: n.y / nh,
        at: (dist[i] ?? maxD) / maxD,
      }));
      const seen = new Set<string>();
      const edges: { a: number; b: number }[] = [];
      found.forEach((_, i) => {
        for (const j of links[i] ?? []) {
          if (dist[i] === Infinity || dist[j] === Infinity) continue;
          const key = i < j ? `${i}-${j}` : `${j}-${i}`;
          if (seen.has(key)) continue;
          seen.add(key);
          edges.push({ a: i, b: j });
        }
      });
      mesh = { nodes, edges };
    }

    function lit(at: number, progress: number) {
      return ease((progress - at * 0.84) / 0.09);
    }

    function restore() {
      const { width, height } = egg!.getBoundingClientRect();
      ctx?.clearRect(0, 0, width, height);
      egg!.classList.remove("is-falling");
      running = false;
    }

    function draw(progress: number) {
      if (!ctx) return;
      const { width, height } = egg!.getBoundingClientRect();
      ctx.clearRect(0, 0, width, height);
      const fade = progress > 0.86 ? 1 - (progress - 0.86) / 0.14 : 1;
      const unit = box.w / 520;

      ctx.save();
      ctx.globalCompositeOperation = "screen";
      ctx.lineCap = "round";
      for (const edge of mesh.edges) {
        const a = mesh.nodes[edge.a];
        const b = mesh.nodes[edge.b];
        if (!a || !b) continue;
        const glow = Math.min(lit(a.at, progress), lit(b.at, progress)) * fade;
        if (glow <= 0.02) continue;
        const pa = toXY(a.x, a.y);
        const pb = toXY(b.x, b.y);
        ctx.strokeStyle = `rgba(243, 213, 138, ${0.22 + 0.7 * glow})`;
        ctx.lineWidth = (0.7 + 1.15 * glow) * unit;
        ctx.beginPath();
        ctx.moveTo(pa.x, pa.y);
        ctx.lineTo(pb.x, pb.y);
        ctx.stroke();
      }

      for (const node of mesh.nodes) {
        const glow = lit(node.at, progress) * fade;
        if (glow <= 0.02) continue;
        const p = toXY(node.x, node.y);
        const peakish = node.at < 0.02;
        const r = (peakish ? 7.2 : 2.15 + 2.4 * glow) * unit;
        const halo = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r * 3.1);
        halo.addColorStop(0, `rgba(255, 248, 220, ${0.95 * glow})`);
        halo.addColorStop(0.22, `rgba(243, 213, 138, ${0.85 * glow})`);
        halo.addColorStop(1, "rgba(197, 157, 95, 0)");
        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(p.x, p.y, r * 3.1, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = `rgba(255, 246, 210, ${0.75 + 0.25 * glow})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, r * 0.42, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }

    function flash() {
      if (!ctx) return;
      sizeCanvas();
      draw(0.55);
      window.setTimeout(restore, 480);
    }

    function play() {
      if (running) return;
      if (!mesh.nodes.length) sampleMesh();
      running = true;
      egg!.classList.add("is-falling");
      sizeCanvas();
      if (reduce) {
        flash();
        return;
      }
      const start = performance.now();
      const tick = (now: number) => {
        const t = (now - start) / DURATION;
        if (t >= 1) {
          restore();
          return;
        }
        draw(t);
        raf = requestAnimationFrame(tick);
      };
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(tick);
    }

    hit.addEventListener("click", play);
    img.addEventListener("load", () => {
      sizeCanvas();
      sampleMesh();
    });
    window.addEventListener("resize", sizeCanvas);
    sizeCanvas();
    if (img.complete) sampleMesh();
  }
</script>

<style is:global>
  body.share-home {
    --gilt: #c59d5f;
    --gilt-bright: #f0d78a;
    background: #000;
    color: #f7f4ee;
  }

  body.share-home .home-stage {
    background: #000;
  }

  .hero-art[data-summit-egg] {
    isolation: isolate;
  }

  .hero-eggs {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 12%;
    bottom: 0.7rem;
    margin: 0;
    pointer-events: none;
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-align: center;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }

  .hero-art .hero-mountain {
    pointer-events: none;
  }

  .summit-fall {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .summit-hit {
    position: absolute;
    z-index: 4;
    width: 8.2rem;
    height: 8.2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    left: 46%;
    top: 20%;
    background: radial-gradient(
      circle,
      rgba(255, 246, 210, 0.14) 0%,
      rgba(212, 175, 90, 0.06) 38%,
      transparent 70%
    );
    box-shadow: 0 0 16px 5px rgba(212, 175, 90, 0.07);
    animation: summit-shimmer 4.2s ease-in-out infinite;
  }

  .summit-hit:hover,
  .summit-hit:focus-visible {
    background: radial-gradient(
      circle,
      rgba(255, 246, 210, 0.58) 0%,
      rgba(212, 175, 90, 0.22) 40%,
      transparent 72%
    );
    box-shadow: 0 0 42px 14px rgba(240, 215, 138, 0.28);
    outline: none;
  }

  .hero-art.is-falling .summit-hit,
  .hero-art.is-falling .summit-hit:hover,
  .hero-art.is-falling .summit-hit:focus-visible {
    animation: none;
    opacity: 0;
    background: transparent;
    box-shadow: none;
  }

  @keyframes summit-shimmer {
    0%,
    100% {
      opacity: 0.32;
      filter: brightness(1);
    }
    50% {
      opacity: 0.52;
      filter: brightness(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .summit-hit {
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .hero-eggs {
      right: 0;
      bottom: 0.45rem;
    }
  }

  .cg-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 0 max(2rem, calc((100vw - 78rem) / 2)) 2.6rem;
    background: #000;
  }

  .cg-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.92rem 1.4rem;
    border-radius: 0;
  }

  .cg-btn-ghost {
    border: 1px solid #c59d5f;
    color: #c59d5f;
    background: transparent;
  }

  .cg-btn-ember {
    background: #b33c1c;
    color: #fff;
    margin-top: 1.7rem;
  }

  .cg-btn-ember:hover {
    color: #fff;
    background: #c44924;
  }

  .cg-built,
  .cg-lived {
    position: relative;
    overflow: hidden;
    min-height: 92vh;
  }

  .cg-built {
    background: #070b18;
  }

  .cg-built-photo,
  .cg-lived-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 72% 48%;
    pointer-events: none;
  }

  .cg-lived-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
