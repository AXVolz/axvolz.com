---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---

<Base
  title="Get in touch"
  description="How to get in touch with Austin X. Volz."
  bodyClass="share-contact"
>
  <div class="page wrap contact-page">
    <h1 class="contact-title">Get in touch</h1>

    <div class="contact-panel">
      <a
        class="contact-write"
        href={site.form}
        target="_blank"
        rel="noopener noreferrer"
      >
        Write
      </a>
    </div>

    <p class="contact-linkedin">
      See the <a href={site.linkedin} rel="me">LinkedIn version</a>.
    </p>
  </div>
</Base>

<style is:global>
  body.share-contact {
    --gilt: #c59d5f;
    background: #000;
    color: #f7f4ee;
  }

  body.share-contact .site-footer {
    background: #000;
    border-top-color: rgba(197, 160, 89, 0.18);
  }
</style>

<style>
  .contact-page {
    max-width: 36rem;
  }

  .contact-title {
    font-family: var(--display);
    font-size: clamp(1.72rem, 3.4vw, 2.7rem);
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.02em;
    color: #c59d5f;
    margin: 0 0 1.1rem;
  }

  .contact-title::after {
    content: "";
    display: block;
    width: 2.35rem;
    height: 1px;
    background: #c59d5f;
    margin-top: 0.85rem;
  }

  .contact-panel {
    margin: 2.1rem 0 2.4rem;
  }

  .contact-write {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.15rem;
    border: 1px solid #c59d5f;
    background: #000;
    color: #c59d5f;
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .contact-write:hover,
  .contact-write:focus-visible {
    color: #d4af5a;
    border-color: #d4af5a;
  }

  .contact-linkedin {
    margin: 0;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(197, 157, 95, 0.28);
    font-family: var(--display);
    font-size: 1.05rem;
    font-style: italic;
    color: rgba(247, 244, 238, 0.68);
    max-width: 36ch;
  }

  .contact-linkedin a {
    color: #c59d5f;
    text-decoration-color: color-mix(in srgb, #c59d5f 45%, transparent);
  }

  .contact-linkedin a:hover {
    color: #f0d78a;
  }
</style>
