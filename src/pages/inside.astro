---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { caveStories } from "../data/cave";
---

<Base
  title="Inside"
  description="Sidequests and adventures along the way."
  bodyClass="share-inside"
  hideHeader
>
  <section class="inside-hero">
    <img
      class="inside-hero-photo"
      src="/cave/interior.jpg"
      alt=""
      width="1600"
      height="900"
      decoding="async"
    />
    <header class="inside-mast">
      <a class="inside-home" href={site.home}>Home</a>
    </header>
    <div class="inside-hero-copy">
      <h1>
        You’ve discovered the <em>cave of stories.</em>
      </h1>
      <p class="inside-lede">
        Lives are not linear. Here I share sidequests and adventures I’ve
        had along the way.
      </p>
    </div>
  </section>

  <section class="inside-collection" id="collection">
    <div class="inside-collection-head">
      <h2>Story collection</h2>
      <div class="inside-carousel-nav">
        <button type="button" class="inside-carousel-btn" data-carousel-prev aria-label="Previous stories">
          ←
        </button>
        <button type="button" class="inside-carousel-btn" data-carousel-next aria-label="Next stories">
          →
        </button>
      </div>
    </div>
    <div class="inside-carousel" data-carousel>
      <ul class="inside-track">
        {
          caveStories.map((story) => (
            <li>
              {story.locked ? (
                <article class="inside-card is-locked" aria-label={`${story.title}, coming soon`}>
                  <div class="inside-card-photo">
                    <img src={story.photo} alt="" width="900" height="675" decoding="async" />
                    <p class="inside-soon">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="6" y="11" width="12" height="9" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
                        <path d="M8.2 11V8.4a3.8 3.8 0 0 1 7.6 0V11" fill="none" stroke="currentColor" stroke-width="1.4"></path>
                      </svg>
                      Coming soon
                    </p>
                  </div>
                  <h3>{story.title}</h3>
                  <p class="inside-when">{story.when}</p>
                </article>
              ) : (
                <a class="inside-card" href={`/inside/${story.slug}`}>
                  <div class="inside-card-photo">
                    <img
                      src={story.photo}
                      alt={story.photoAlt}
                      width="900"
                      height="675"
                      decoding="async"
                    />
                  </div>
                  <h3>{story.title}</h3>
                  <p class="inside-when">{story.when}</p>
                  {story.note && <p class="inside-note">{story.note}</p>}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  const scroller = document.querySelector<HTMLElement>("[data-carousel]");
  const prev = document.querySelector<HTMLButtonElement>("[data-carousel-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-carousel-next]");
  if (scroller && prev && next) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const step = () => {
      const card = scroller.querySelector("li");
      if (!(card instanceof HTMLElement)) return 280;
      const styles = getComputedStyle(scroller.querySelector(".inside-track")!);
      const gap = Number.parseFloat(styles.columnGap || styles.gap) || 18;
      return card.getBoundingClientRect().width + gap;
    };

    const sync = () => {
      const max = scroller.scrollWidth - scroller.clientWidth - 2;
      const overflow = max > 4;
      prev.hidden = !overflow;
      next.hidden = !overflow;
      prev.disabled = scroller.scrollLeft <= 2;
      next.disabled = scroller.scrollLeft >= max;
    };

    const go = (dir: number) => {
      scroller.scrollBy({
        left: dir * step(),
        behavior: reduce ? "auto" : "smooth",
      });
    };

    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));
    scroller.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();
  }
</script>

<style is:global>
  body.share-inside main {
    padding: 0;
  }
</style>

<style>
  .inside-hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: #070605;
  }

  .inside-hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 52% 42%;
    pointer-events: none;
  }

  .inside-mast {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: flex;
    align-items: center;
    padding: 1.15rem max(2rem, calc((100vw - 78rem) / 2));
  }

  .inside-home {
    font-family: var(--ui);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(247, 244, 238, 0.92);
    text-decoration: none;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
  }

  .inside-home:hover,
  .inside-home:focus-visible {
    color: var(--gilt-bright);
  }

  .inside-hero-copy {
    position: relative;
    z-index: 2;
    width: min(38rem, calc(100% - 3.2rem));
    padding: 0 0 5.5rem max(2rem, calc((100vw - 78rem) / 2));
  }

  .inside-hero-copy h1 {
    font-size: clamp(2.05rem, 4.2vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.08;
    max-width: 14ch;
    margin: 0;
    color: #f7f4ee;
    text-shadow: 0 8px 28px rgba(7, 6, 5, 0.55);
  }

  .inside-hero-copy h1 em {
    font-style: italic;
    color: #c59d5f;
  }

  .inside-lede {
    font-family: var(--ui);
    font-size: 1.12rem;
    line-height: 1.5;
    max-width: 36ch;
    margin: 1.15rem 0 0;
    color: rgba(247, 244, 238, 0.82);
  }

  .inside-collection {
    padding: 4.2rem 0 5.4rem;
    background: #000;
  }

  .inside-collection-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: max(2rem, calc((100vw - 78rem) / 2));
    margin-bottom: 1.6rem;
  }

  .inside-collection h2 {
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c59d5f;
    margin: 0;
  }

  .inside-carousel-nav {
    display: flex;
    gap: 0.45rem;
  }

  .inside-carousel-btn {
    width: 2.2rem;
    height: 2.2rem;
    padding: 0;
    border: 1px solid #c59d5f;
    background: transparent;
    color: #c59d5f;
    font-family: var(--ui);
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
  }

  .inside-carousel-btn:hover,
  .inside-carousel-btn:focus-visible {
    color: #f0d78a;
    border-color: #f0d78a;
    outline: none;
  }

  .inside-carousel-btn:disabled,
  .inside-carousel-btn[hidden] {
    opacity: 0.28;
    cursor: default;
  }

  .inside-carousel-btn[hidden] {
    display: none;
  }

  .inside-carousel {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    mask-image: linear-gradient(
      90deg,
      #000 0%,
      #000 calc(100% - 3.5rem),
      transparent 100%
    );
  }

  .inside-carousel::-webkit-scrollbar {
    display: none;
  }

  .inside-track {
    list-style: none;
    display: flex;
    gap: 1.15rem;
    margin: 0;
    width: max-content;
    padding: 0 max(2rem, calc((100vw - 78rem) / 2));
  }

  .inside-track > li {
    flex: 0 0 clamp(15.2rem, 22vw, 18.4rem);
    scroll-snap-align: start;
  }

  .inside-card {
    display: grid;
    gap: 0.7rem;
    color: inherit;
    text-decoration: none;
  }

  .inside-card-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid rgba(197, 157, 95, 0.42);
    background: #120e0b;
  }

  .inside-card-photo img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .inside-card h3 {
    font-family: var(--display);
    font-size: 1.12rem;
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.02em;
    color: #c59d5f;
    margin: 0;
  }

  .inside-when {
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.55);
    margin: 0;
  }

  .inside-note {
    font-family: var(--ui);
    font-size: 0.98rem;
    line-height: 1.45;
    color: rgba(247, 244, 238, 0.72);
    margin: 0;
  }

  a.inside-card:hover h3,
  a.inside-card:focus-visible h3 {
    color: #f0d78a;
  }

  .inside-card.is-locked .inside-card-photo img {
    filter: grayscale(0.35) brightness(0.42);
  }

  .inside-soon {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.45rem;
    margin: 0;
    background: rgba(8, 6, 4, 0.42);
    color: #e8d7a8;
    font-family: var(--ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .inside-soon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  @media (max-width: 640px) {
    .inside-hero-copy,
    .inside-mast,
    .inside-collection-head,
    .inside-track {
      padding-inline: 1.4rem;
    }

    .inside-hero-copy {
      padding-bottom: 3.4rem;
    }

    .inside-track > li {
      flex-basis: 78vw;
    }
  }
</style>
