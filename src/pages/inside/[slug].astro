---
import Base from "../../layouts/Base.astro";
import { caveStories, caveStory } from "../../data/cave";

export function getStaticPaths() {
  return caveStories
    .filter((story) => !story.locked)
    .map((story) => ({ params: { slug: story.slug } }));
}

const story = caveStory(Astro.params.slug ?? "");
if (!story) throw new Error(`Unknown cave story: ${Astro.params.slug}`);

const scenes = story.scenes ?? [];
const isWall = scenes.length > 0;
---

<Base
  title={story.title}
  description={story.intro ?? story.note ?? story.title}
  bodyClass="share-inside"
>
  <article class:list={["inside-story", "page", "wrap", { "is-wall": isWall }]}>
    <p class="inside-back">
      <a href="/inside">Cave of stories</a>
    </p>
    <h1>{story.title}</h1>
    <p class="inside-when">{story.when}</p>
    {story.intro && <p class="inside-story-intro">{story.intro}</p>}

    {
      isWall ? (
        <ul class="scene-wall">
          {scenes.map((scene) => (
            <li>
              <button
                type="button"
                class="scene-tile"
                data-scene={scene.src}
                aria-label={scene.alt}
              >
                <img src={scene.src} alt="" decoding="async" />
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <img
          class="inside-story-photo"
          src={story.photo}
          alt={story.photoAlt}
          width="900"
          height="675"
          decoding="async"
        />
      )
    }

    {story.note && <p class="inside-story-note">{story.note}</p>}
  </article>

  {
    isWall && (
      <dialog class="scene-open" data-scene-open aria-label="Photograph">
        <form method="dialog">
          <button type="submit" class="scene-close">Close</button>
        </form>
        <button type="button" class="scene-step" data-scene-prev aria-label="Previous photograph">
          ←
        </button>
        <img alt="" />
        <button type="button" class="scene-step" data-scene-next aria-label="Next photograph">
          →
        </button>
      </dialog>
    )
  }
</Base>

{
  isWall && (
    <script>
      const dialog = document.querySelector("[data-scene-open]");
      const frame = dialog?.querySelector("img");
      const prev = dialog?.querySelector("[data-scene-prev]");
      const next = dialog?.querySelector("[data-scene-next]");
      if (
        dialog instanceof HTMLDialogElement &&
        frame instanceof HTMLImageElement &&
        prev instanceof HTMLButtonElement &&
        next instanceof HTMLButtonElement
      ) {
        const scenes = [...document.querySelectorAll("[data-scene]")].flatMap((tile) => {
          const src = tile.getAttribute("data-scene");
          if (!src) return [];
          return [{ src, label: tile.getAttribute("aria-label") ?? "" }];
        });
        let index = 0;
        let fromHistory = false;

        const show = (i: number, replace: boolean) => {
          index = (i + scenes.length) % scenes.length;
          const scene = scenes[index];
          if (!scene) return;
          frame.src = scene.src;
          frame.alt = scene.label;
          if (replace) history.replaceState({ scene: scene.src }, "");
        };

        document.querySelectorAll("[data-scene]").forEach((tile, i) => {
          tile.addEventListener("click", () => {
            show(i, false);
            dialog.showModal();
            history.pushState({ scene: scenes[index].src }, "");
          });
        });

        prev.addEventListener("click", () => show(index - 1, true));
        next.addEventListener("click", () => show(index + 1, true));
        frame.addEventListener("click", () => show(index + 1, true));

        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });

        dialog.addEventListener("keydown", (event) => {
          if (event.key === "ArrowRight") {
            event.preventDefault();
            show(index + 1, true);
          }
          if (event.key === "ArrowLeft") {
            event.preventDefault();
            show(index - 1, true);
          }
        });

        dialog.addEventListener("close", () => {
          if (fromHistory) {
            fromHistory = false;
            return;
          }
          if (history.state && typeof history.state === "object" && "scene" in history.state) {
            history.back();
          }
        });

        window.addEventListener("popstate", () => {
          if (!dialog.open) return;
          fromHistory = true;
          dialog.close();
        });
      }
    </script>
  )
}

<style>
  .inside-story {
    max-width: 40rem;
    padding-bottom: 5rem;
  }

  .inside-story.is-wall {
    max-width: none;
  }

  .inside-back {
    margin: 0 0 1.6rem;
  }

  .inside-back a {
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c59d5f;
    text-decoration: none;
  }

  .inside-back a:hover,
  .inside-back a:focus-visible {
    color: #f0d78a;
  }

  .inside-story h1 {
    font-size: clamp(2.05rem, 4vw, 3.05rem);
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.03em;
    color: #c59d5f;
    margin: 0;
  }

  .inside-when {
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 244, 238, 0.55);
    margin: 0.7rem 0 1.6rem;
  }

  .inside-story.is-wall .inside-when {
    margin-bottom: 1.15rem;
  }

  .inside-story-intro {
    font-family: var(--ui);
    font-size: 1.12rem;
    line-height: 1.55;
    color: rgba(247, 244, 238, 0.78);
    margin: 0 0 2rem;
    max-width: 48ch;
  }

  .inside-story-photo {
    width: 100%;
    height: auto;
    border: 1px solid rgba(197, 157, 95, 0.42);
  }

  .inside-story-note {
    font-family: var(--ui);
    font-size: 1.15rem;
    line-height: 1.55;
    color: rgba(247, 244, 238, 0.78);
    margin: 1.4rem 0 0;
    max-width: 38ch;
  }

  .scene-wall {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.28rem;
  }

  .scene-tile {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(197, 157, 95, 0.28);
    background: #0a0907;
    cursor: zoom-in;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .scene-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease, filter 0.45s ease;
  }

  .scene-tile:hover img,
  .scene-tile:focus-visible img {
    transform: scale(1.04);
    filter: brightness(1.08);
  }

  .scene-tile:hover,
  .scene-tile:focus-visible {
    border-color: rgba(240, 215, 138, 0.72);
    outline: none;
  }

  .scene-open {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 3vh 4vw;
    border: none;
    background: #000;
    cursor: default;
  }

  .scene-open:not([open]) {
    display: none;
  }

  .scene-open[open] {
    display: grid;
    place-items: center;
  }

  .scene-open::backdrop {
    background: rgba(0, 0, 0, 0.94);
  }

  .scene-close {
    position: absolute;
    top: 1.35rem;
    left: 1.5rem;
    z-index: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c59d5f;
    cursor: pointer;
  }

  .scene-close:hover,
  .scene-close:focus-visible {
    color: #f0d78a;
    outline: none;
  }

  .scene-step {
    position: absolute;
    top: 50%;
    z-index: 1;
    width: 2.2rem;
    height: 2.2rem;
    padding: 0;
    border: 1px solid #c59d5f;
    background: transparent;
    color: #c59d5f;
    font-family: var(--ui);
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .scene-step[data-scene-prev] {
    left: 1.5rem;
  }

  .scene-step[data-scene-next] {
    right: 1.5rem;
  }

  .scene-step:hover,
  .scene-step:focus-visible {
    color: #f0d78a;
    border-color: #f0d78a;
    outline: none;
  }

  .scene-open img {
    max-width: min(100%, calc(100% - 8rem));
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    box-shadow: 0 0 0 1px rgba(197, 157, 95, 0.28);
    cursor: pointer;
  }

  @media (max-width: 820px) {
    .scene-wall {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 520px) {
    .scene-wall {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
