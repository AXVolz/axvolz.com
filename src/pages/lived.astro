---
import Base from "../layouts/Base.astro";
import LivedCave from "../components/LivedCave.astro";
import { site } from "../data/site";
import { cityName, localityLine, placeLabel, places, ridgePts } from "../data/places";

const hereIndex = places.length - 1;
const cityCount = new Set(places.map((place) => place.city)).size;

const placeStars = places.map((place, i) => ({
  ...place,
  locality: localityLine(place),
  x: ridgePts[i]![0],
  y: ridgePts[i]![1],
  i,
}));

const placePath = placeStars
  .map((p, i) => `${i === 0 ? "M" : "L"} ${p.x} ${p.y}`)
  .join(" ");
---

<Base
  title="Lived"
  description="Places Austin X. Volz has lived."
  bodyClass="lived-enfilade"
  hideHeader
>
  <div class="lived-summit">
    <header class="lived-summit-mast">
      <a class="lived-home" href={site.home}>Home</a>
      <a class="lived-touch" href="/contact">Get in touch</a>
    </header>

    <section class="cg-lived" aria-label="How I got here">
      <div class="cg-lived-stage">
        <img
          class="cg-lived-photo"
          src="/lived-golden-hour.png"
          alt=""
          width="1536"
          height="1024"
          decoding="async"
        />
        <div class="cg-lived-plot">
          <svg
            class="cg-day-sky"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d={placePath}
              fill="none"
              stroke="#d4af5a"
              stroke-width="1.05"
              opacity="0.7"></path>
          </svg>

          <div class="cg-stars cg-stars-day">
            {
              placeStars.map((star, i) => (
                <div
                  class:list={["cg-star", "cg-star-place", { "is-on": i === hereIndex }]}
                  style={`left:${star.x}%; top:${star.y}%`}
                  data-star={star.slug}
                >
                  <span class="cg-star-core" aria-hidden="true"></span>
                  <a
                    class="cg-star-name"
                    href={`#${star.slug}`}
                    aria-current={i === hereIndex ? "true" : undefined}
                  >
                    {star.city}
                  </a>
                </div>
              ))
            }
        </div>
        <LivedCave />
      </div>
      </div>

      <div class="cg-lived-copy">
        <h1>
          How I got here.
          <em>An early love of languages propelled me around the world.</em>
        </h1>
        <p class="cg-lived-count">
          {cityCount} cities · Greece, Germany, China, USA
        </p>
      </div>
    </section>
  </div>

  <div class="axis" aria-hidden="true"></div>

  <nav class="ticks" aria-label="Places">
    {
      places.map((place) => (
        <a href={`#${place.slug}`} data-slug={place.slug} aria-label={placeLabel(place)}>
          <span></span>
        </a>
      ))
    }
  </nav>

  <div class="enfilade">
    {
      places.map((place) => (
        <section class="station" id={place.slug}>
          <article class="plate">
            <div class:list={["plate-inner", { "has-photo": Boolean(place.photo) }]}>
              {
                place.photo && (
                  <img
                    class="plate-field"
                    src={place.photo}
                    alt={place.photoAlt ?? ""}
                    width="1024"
                    height="685"
                    decoding="async"
                  />
                )
              }
              <svg class="graticule" viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true">
                <line class="prime" x1="50" y1="0" x2="50" y2="60"></line>
                <line x1="0" y1="30" x2="100" y2="30"></line>
                <line x1="0" y1="14" x2="100" y2="14"></line>
                <line x1="0" y1="46" x2="100" y2="46"></line>
              </svg>
              {
                place.ghost && (
                  <p class="ghost" lang={place.ghost.lang} aria-hidden="true">
                    {place.ghost.text}
                  </p>
                )
              }
              <div class="plate-legend">
                <h2 class="city">{cityName(place)}</h2>
                <p class="locality">{localityLine(place)}</p>
                <p class="note">{place.note}</p>
              </div>
            </div>
          </article>
        </section>
      ))
    }
  </div>
</Base>

<script>
  const stations = [...document.querySelectorAll<HTMLElement>(".station")];
  const ticks = document.querySelectorAll<HTMLAnchorElement>(".ticks a");
  const summit = document.querySelector<HTMLElement>(".lived-summit");

  function setCurrent(slug: string) {
    for (const tick of ticks) {
      const on = tick.dataset.slug === slug;
      tick.setAttribute("aria-current", on ? "true" : "false");
    }
  }

  function pastSummit() {
    if (!summit) return true;
    return summit.getBoundingClientRect().bottom < window.innerHeight * 0.55;
  }

  function nearestStation() {
    document.body.classList.toggle("in-enfilade", pastSummit());

    const mid = window.innerHeight * 0.45;
    let best = stations[0];
    let bestDist = Infinity;
    for (const station of stations) {
      const rect = station.getBoundingClientRect();
      const dist = Math.abs(rect.top + rect.height / 2 - mid);
      if (dist < bestDist) {
        bestDist = dist;
        best = station;
      }
    }
    if (best) setCurrent(best.id);
  }

  nearestStation();
  window.addEventListener("scroll", nearestStation, { passive: true });
  window.addEventListener("resize", nearestStation);

  function goToHash() {
    const id = location.hash.replace("#", "");
    if (!id) return;
    document.getElementById(id)?.scrollIntoView();
    nearestStation();
  }

  goToHash();
  window.addEventListener("hashchange", goToHash);
</script>

<script>
  function parsePos(value: string, fallback: number) {
    if (value.endsWith("%")) return Number.parseFloat(value) / 100;
    return fallback;
  }

  function fitLivedPlot() {
    const section = document.querySelector<HTMLElement>(".cg-lived");
    const img = section?.querySelector<HTMLImageElement>(".cg-lived-photo");
    const plot = section?.querySelector<HTMLElement>(".cg-lived-plot");
    if (!section || !img || !plot) return;

    const r = img.getBoundingClientRect();
    const host = section.getBoundingClientRect();
    const nw = img.naturalWidth || 1536;
    const nh = img.naturalHeight || 1024;
    if (!r.width || !r.height) return;

    const ir = nw / nh;
    const cr = r.width / r.height;
    const fit = getComputedStyle(img).objectFit;
    const parts = getComputedStyle(img).objectPosition.split(" ");
    const ox = parsePos(parts[0] ?? "50%", 0.5);
    const oy = parsePos(parts[1] ?? "50%", 0.5);

    let w: number;
    let h: number;
    if (fit === "contain") {
      if (ir > cr) {
        w = r.width;
        h = r.width / ir;
      } else {
        h = r.height;
        w = r.height * ir;
      }
    } else if (cr > ir) {
      w = r.width;
      h = r.width / ir;
    } else {
      h = r.height;
      w = r.height * ir;
    }

    plot.style.left = `${r.left - host.left + (r.width - w) * ox}px`;
    plot.style.top = `${r.top - host.top + (r.height - h) * oy}px`;
    plot.style.width = `${w}px`;
    plot.style.height = `${h}px`;
  }

  fitLivedPlot();
  window.addEventListener("resize", fitLivedPlot);
  document.querySelector(".cg-lived-photo")?.addEventListener("load", fitLivedPlot);
</script>

<style is:global>
  body.lived-enfilade {
    --sea: #163036;
    --sea-deep: #101f23;
    --plate: #e3d4b6;
    --wash: #b8c2b6;
    --neatline: #7a6240;
    --gall: #1c1710;
    --gall-soft: rgba(28, 23, 16, 0.6);
    --brass: #a4844a;
    --ink: #e3d4b6;
    --ink-soft: rgba(227, 212, 182, 0.66);
    --gilt: #c4a15a;
    color: var(--ink);
    background-color: var(--sea-deep);
    background-image: radial-gradient(
      ellipse 120% 100% at 50% 40%,
      var(--sea) 0%,
      var(--sea-deep) 72%
    );
  }

  body.lived-enfilade .site-footer {
    display: none;
  }

  body.lived-enfilade main {
    padding: 0;
  }

  html:has(body.lived-enfilade) {
    scroll-snap-type: y mandatory;
  }
</style>

<style>
  .lived-summit {
    position: relative;
    z-index: 4;
    height: 68svh;
    min-height: 22rem;
    overflow: hidden;
    background: #f5f0e6;
    color: #24180f;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .lived-summit-mast {
    position: absolute;
    inset: 0 0 auto;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem max(2rem, calc((100vw - 78rem) / 2));
  }

  .lived-home {
    font-family: var(--ui);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #1c1710;
    text-decoration: none;
    text-shadow: 0 1px 10px rgba(245, 240, 230, 0.7);
  }

  .lived-home:hover,
  .lived-home:focus-visible {
    color: #c45c28;
  }

  .lived-touch {
    display: inline-flex;
    align-items: center;
    font-family: var(--ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.55rem 0.95rem;
    border: 1px solid #c59d5f;
    color: #c59d5f;
  }

  .lived-touch:hover,
  .lived-touch:focus-visible {
    color: #a3441c;
    border-color: #a3441c;
  }

  .cg-lived {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 100%;
    background: #f5f0e6;
    color: #24180f;
  }

  .cg-lived-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 72% 48%;
    pointer-events: none;
  }

  .cg-lived-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .cg-lived-plot {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .cg-day-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .cg-lived::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 1;
    width: min(44rem, 54%);
    pointer-events: none;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, #f5f0e6 78%, transparent) 0%,
      color-mix(in srgb, #f5f0e6 42%, transparent) 52%,
      transparent 100%
    );
  }

  .cg-lived-copy {
    position: relative;
    z-index: 2;
    width: min(38rem, calc(100% - 3.2rem));
    padding: 3.6rem 0 3.2rem max(2rem, calc((100vw - 78rem) / 2));
  }

  .cg-lived-copy h1 {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #2a2118;
    max-width: 22ch;
    margin: 0;
    text-shadow: 0 1px 14px rgba(245, 240, 230, 0.72);
  }

  .cg-lived-copy h1 em {
    display: block;
    margin-top: 0.28rem;
    font-size: clamp(1.45rem, 2.8vw, 2.15rem);
    line-height: 1.08;
    color: #c45c28;
    font-style: italic;
    font-weight: 500;
    max-width: 14ch;
    text-shadow: 0 1px 16px rgba(245, 240, 230, 0.6);
  }

  .cg-lived-count {
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9a7430;
    margin: 0.85rem 0 0;
    text-shadow: 0 1px 10px rgba(245, 240, 230, 0.7);
  }

  .cg-stars {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .cg-star {
    position: absolute;
    z-index: 0;
    width: 0.68rem;
    height: 0.68rem;
    padding: 0;
    border: 0;
    background: transparent;
    transform: translate(-50%, -50%);
    pointer-events: none;
    color: inherit;
    isolation: isolate;
  }

  .cg-star-core {
    display: block;
    position: relative;
    z-index: 0;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: #f3d58a;
    box-shadow: 0 0 0 1px rgba(196, 150, 70, 0.85), 0 0 10px 2px rgba(232, 176, 80, 0.45);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .cg-star:hover .cg-star-core,
  .cg-star.is-on .cg-star-core,
  .cg-star:has(.cg-star-name:focus-visible) .cg-star-core,
  .cg-star:has(.cg-star-name[aria-current="true"]) .cg-star-core {
    transform: scale(1.28);
    box-shadow: 0 0 0 2px #fff8e8, 0 0 16px 5px rgba(232, 176, 80, 0.7);
  }

  .cg-star-name {
    position: absolute;
    left: 50%;
    top: calc(100% - 0.2rem);
    z-index: 1;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--display);
    font-size: clamp(0.78rem, 0.95vw, 0.9rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #f4e4b8;
    opacity: 1;
    pointer-events: auto;
    cursor: pointer;
    text-decoration: none;
    padding: 0.12rem 0.28rem;
    text-shadow:
      -1px -1px 0 rgba(18, 10, 4, 0.82),
      1px -1px 0 rgba(18, 10, 4, 0.82),
      -1px 1px 0 rgba(18, 10, 4, 0.82),
      1px 1px 0 rgba(18, 10, 4, 0.82),
      0 0 10px rgba(247, 232, 200, 0.55),
      0 2px 8px rgba(16, 8, 4, 0.58);
  }

  .cg-star[data-star="santa-fe-2"] .cg-star-name {
    transform: translateX(calc(-50% - 0.7rem));
  }

  .cg-star[data-star="dresden"] .cg-star-name {
    transform: translateX(calc(-50% + 0.75rem));
  }

  .cg-star:hover .cg-star-name,
  .cg-star.is-on .cg-star-name,
  .cg-star-name:focus-visible,
  .cg-star-name[aria-current="true"] {
    opacity: 1;
    color: #fff3d2;
  }

  .axis {
    position: fixed;
    left: 50%;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 1px;
    background: color-mix(in srgb, var(--brass) 28%, transparent);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  body.in-enfilade .axis {
    opacity: 1;
  }

  .ticks {
    position: fixed;
    right: 1.35rem;
    top: 50%;
    z-index: 5;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.72rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  body.in-enfilade .ticks {
    opacity: 1;
    pointer-events: auto;
  }

  .ticks a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ticks span {
    display: block;
    width: 0.65rem;
    height: 1px;
    background: color-mix(in srgb, var(--ink) 28%, transparent);
  }

  .ticks a[aria-current="true"] span {
    width: 1.15rem;
    height: 1px;
    background: var(--brass);
  }

  .enfilade {
    position: relative;
  }

  .station {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: 4.5rem 1.75rem;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .plate {
    position: relative;
    z-index: 2;
    width: min(56rem, 82vw);
    padding: 5px;
    background: var(--plate);
    border: 1px solid var(--neatline);
  }

  .plate-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: min(62vh, 28rem);
    padding: 4.6rem 3rem 3.8rem;
    border: 1px solid color-mix(in srgb, var(--neatline) 55%, var(--plate));
    background:
      radial-gradient(
        ellipse 64% 58% at 50% 48%,
        var(--plate) 0%,
        var(--plate) 46%,
        var(--wash) 100%
      );
    overflow: hidden;
    text-align: center;
  }

  .plate-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 42% 38%;
    filter: sepia(0.32) saturate(0.62) contrast(0.94) brightness(0.96);
    pointer-events: none;
  }

  .plate-inner.has-photo {
    background: var(--plate);
  }

  .plate-inner.has-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(
        ellipse 68% 60% at 50% 48%,
        color-mix(in srgb, var(--plate) 22%, transparent) 0%,
        color-mix(in srgb, var(--plate) 48%, transparent) 58%,
        color-mix(in srgb, var(--plate) 78%, var(--wash)) 100%
      );
    pointer-events: none;
  }

  .plate-legend {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .plate-inner.has-photo .plate-legend {
    padding: 1.25rem 1.9rem 1.15rem;
    background:
      radial-gradient(
        ellipse 82% 72% at 50% 48%,
        color-mix(in srgb, var(--plate) 96%, transparent) 0%,
        color-mix(in srgb, var(--plate) 82%, transparent) 58%,
        color-mix(in srgb, var(--plate) 28%, transparent) 82%,
        transparent 100%
      );
  }

  .graticule {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: color-mix(in srgb, var(--neatline) 22%, transparent);
    stroke-width: 0.15;
    pointer-events: none;
  }

  .graticule .prime {
    stroke: color-mix(in srgb, var(--neatline) 40%, transparent);
    stroke-width: 0.22;
  }

  .ghost {
    position: absolute;
    left: 50%;
    top: 46%;
    z-index: 2;
    margin: 0;
    transform: translate(-50%, -52%);
    font-size: clamp(3.6rem, 11vw, 8rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.8;
    color: var(--gall);
    opacity: 0.06;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .ghost[lang="zh"] {
    font-family: "Noto Serif SC", "Noto Serif", var(--display);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .ghost[lang="el"] {
    font-family: "Noto Serif", var(--display);
    font-style: italic;
    font-weight: 400;
  }

  .city {
    position: relative;
    z-index: 3;
    font-size: clamp(2.5rem, 5.8vw, 4.6rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: var(--gall);
  }

  .locality {
    position: relative;
    z-index: 3;
    margin-top: 0.7rem;
    font-family: var(--ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--gall) 52%, transparent);
  }

  .note {
    position: relative;
    z-index: 3;
    max-width: 36ch;
    margin: 1.35rem auto 0;
    font-family: var(--ui);
    font-size: 1rem;
    line-height: 1.45;
    color: var(--gall-soft);
  }

  .plate-inner.has-photo .city,
  .plate-inner.has-photo .locality,
  .plate-inner.has-photo .note {
    text-shadow:
      0 0 22px var(--plate),
      0 0 10px color-mix(in srgb, var(--plate) 90%, transparent),
      0 1px 0 color-mix(in srgb, var(--plate) 85%, transparent);
  }

  .plate-inner.has-photo .locality {
    color: color-mix(in srgb, var(--gall) 88%, var(--plate));
  }

  .plate-inner.has-photo .note {
    color: var(--gall);
  }

  @media (max-width: 840px) {
    .cg-lived-copy {
      padding: 3.4rem 1.4rem 5.5rem;
      width: auto;
    }

    .cg-lived-photo {
      object-fit: contain;
      object-position: 50% 100%;
    }
  }

  @media (max-width: 640px) {
    .lived-summit-mast {
      padding: 0.65rem 1.15rem 0;
    }

    .ticks {
      right: 0.85rem;
    }

    .plate {
      width: calc(100vw - 2.4rem);
    }

    .plate-inner {
      min-height: 48vh;
      padding: 3.2rem 1.35rem 2.8rem;
    }

    .note {
      max-width: 28ch;
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html:has(body.lived-enfilade) {
      scroll-snap-type: none;
    }

    .lived-summit,
    .station {
      scroll-snap-align: none;
    }
  }
</style>
